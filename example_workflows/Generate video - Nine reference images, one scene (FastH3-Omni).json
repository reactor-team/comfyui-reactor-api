      "widgets_values": [
        "<Subject 1> is the weathered fisherman in <Picture 1>, with grey stubble, wearing the red lacquered samurai armour from <Picture 5> instead of his oilskins.\n<Subject 2> is the woman in <Picture 2>, with dark tied-back hair, wearing the gold sequined jacket from <Picture 6>.\n<Subject 3> is the woman in <Picture 3>, with long dark curly hair and a pale blue hoodie.\n<Subject 4> is the white marble statue of a robed woman in <Picture 4>, standing on its plinth.\nIn one shot at night on the rain-soaked neon street from <Picture 8>, <Subject 1>, <Subject 2> and <Subject 3> walk toward the camera side by side and stop beside <Subject 4>, which stands on the pavement. <Subject 3> points up and laughs.\nAbove them a huge lit billboard shows the turquoise beach and the jet ski from <Picture 7>. On a shop window beside the statue hangs a poster of the anime character with teal hair and a denim jacket from <Picture 9>.\nCamera: a slow push in from a wide shot to a medium shot of the three friends beside the statue.\nDialogue: <Subject 3> says, \"Look, we're on the billboard!\"\nSound: rain on the pavement, distant traffic, buzzing neon.",
        "8",
        "shot",
        "16:9"
      ],
      "widgets_values_named": {
        "prompt": "<Subject 1> is the weathered fisherman in <Picture 1>, with grey stubble, wearing the red lacquered samurai armour from <Picture 5> instead of his oilskins.\n<Subject 2> is the woman in <Picture 2>, with dark tied-back hair, wearing the gold sequined jacket from <Picture 6>.\n<Subject 3> is the woman in <Picture 3>, with long dark curly hair and a pale blue hoodie.\n<Subject 4> is the white marble statue of a robed woman in <Picture 4>, standing on its plinth.\nIn one shot at night on the rain-soaked neon street from <Picture 8>, <Subject 1>, <Subject 2> and <Subject 3> walk toward the camera side by side and stop beside <Subject 4>, which stands on the pavement. <Subject 3> points up and laughs.\nAbove them a huge lit billboard shows the turquoise beach and the jet ski from <Picture 7>. On a shop window beside the statue hangs a poster of the anime character with teal hair and a denim jacket from <Picture 9>.\nCamera: a slow push in from a wide shot to a medium shot of the three friends beside the statue.\nDialogue: <Subject 3> says, \"Look, we're on the billboard!\"\nSound: rain on the pavement, distant traffic, buzzing neon.",
        "seconds": "8",
        "kind": "shot",
        "aspect": "16:9"
      }
